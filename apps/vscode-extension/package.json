{
  "name": "@kur3/vscode-extension",
  "displayName": "KUR3 Harness",
  "description": "VS Code panel + bridge for the KUR3 offline harness (W07).",
  "version": "0.1.0",
  "private": true,
  "publisher": "kur3",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:kur3.openPanel",
    "onCommand:kur3.startOfflineDemo",
    "onCommand:kur3.cancelRun"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kur3.openPanel",
        "title": "KUR3: Open Harness Panel"
      },
      {
        "command": "kur3.startOfflineDemo",
        "title": "KUR3: Start Offline Demo Run"
      },
      {
        "command": "kur3.cancelRun",
        "title": "KUR3: Cancel Active Run"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/host-client.test.ts",
    "demo:extension-offline": "tsx src/bridge-host-main.ts --once-offline",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kur3/contracts": "0.1.0",
    "@kur3/core": "0.1.0",
    "@kur3/providers": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
